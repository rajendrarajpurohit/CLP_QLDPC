KNOWN6 := [ [960,24,40,6],[672,20,32,6],[720,16,36,6],[930,18,36,6],[630,12,34,6],[600,16,30,6],
            [576,32,20,6],[510,16,26,6],[558,14,28,6],[630,20,24,6],[558,10,32,6],[630,8,36,6],
            [540,8,32,6],[576,12,30,6],[540,12,28,6],[450,12,26,6],[434,16,22,6],[434,10,28,6],
            [480,8,30,6],[420,8,26,6],[360,20,20,6],[360,12,24,6],[340,16,18,6],[330,8,24,6],
            [288,12,18,6],[248,10,18,6],[240,8,20,6],[168,10,14,6],[144,12,12,6],[90,8,10,6] ];;
Dominated6 := function( N, K, d )
  return ForAny( KNOWN6, c -> ForAny( [ 1 .. Int( N / c[1] ) ], t -> t * c[2] >= K and c[3] >= d ) );
end;;
NeedD := function( K, N )
  local dd;
  for dd in [ 12 .. 60 ] do if not Dominated6( N, K, dd ) then return dd; fi; od;
  return 99;
end;;
